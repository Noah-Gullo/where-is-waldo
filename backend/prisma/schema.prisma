generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model character{
  id Int @id @default(autoincrement())
  name String
  bottom Int
  top Int
  left Int
  right Int
}

model Score {
  id        Int      @id @default(autoincrement())
  name      String
  timeMs    Int
  board     String
  createdAt DateTime @default(now())
}